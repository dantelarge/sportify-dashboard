# Copy this file to .env.local and fill in your Spotify Client ID.
# Get it from https://developer.spotify.com/dashboard
#
# IMPORTANT: Never add SPOTIFY_CLIENT_SECRET here. PKCE auth requires no secret.
# The redirect URI registered in your Spotify app must be:
#   http://127.0.0.1:3000/callback

NEXT_PUBLIC_SPOTIFY_CLIENT_ID=your_client_id_here
